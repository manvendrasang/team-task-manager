# ---- Server ----
PORT=5000
NODE_ENV=development

# MongoDB connection string. Atlas or local both work:
#   mongodb+srv://<user>:<pass>@cluster.mongodb.net/team-task-manager
#   mongodb://127.0.0.1:27017/team-task-manager
MONGO_URI=mongodb://127.0.0.1:27017/team-task-manager

# Signs session tokens. Generate one with: openssl rand -base64 48
JWT_SECRET=replace_this_with_a_long_random_string

# How long a signed-in session lasts (jsonwebtoken syntax).
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Comma-separated list of front-end origins allowed to call the API.
#
# Leave EMPTY in production: Express serves the built client, so the UI and the
# API share one origin and no cross-origin access happens.
#
# In development the Vite dev server runs on port 3000 and talks to the API on
# port 5000, so allow that origin:
CLIENT_ORIGIN=http://localhost:3000